---
/**
 * Research index — a plain list of pieces, each row revealing its index on the
 * right. Rows rise in sequence on entry and the title warms to the link colour
 * on hover.
 */
import PageLayout from '../../layouts/PageLayout.astro'
import { research } from '../../data'
---

<PageLayout
  pathname="/research"
  title="research"
  meta="notes and deep dives into protocol and market mechanics."
>
  <ul>
    {
      research.map((entry, i) => (
        <li
          class="rise border-b border-border py-5 first:pt-0 last:border-0 last:pb-0"
          style={`animation-delay:${i * 70}ms`}
        >
          <a href={`/research/${entry.id}`} class="group touch block">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[15px] text-foreground transition-colors duration-150 group-hover:text-link">
                {entry.title}
              </span>
              <span class="shrink-0 text-[12px] text-muted-foreground">{entry.index}</span>
            </div>
            <p class="mt-1 text-[13px] leading-[1.55] text-muted-foreground">{entry.text}</p>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
