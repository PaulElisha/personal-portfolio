---
/**
 * Thin progress rail pinned to the top of the viewport.
 * Tracks read depth on the long detail surfaces; hidden on short ones
 * (the script leaves it at zero width when there is nothing to scroll).
 */
---

<div class="scroll-rail" data-scroll-rail aria-hidden="true"></div>

<script is:inline>
  ;(function () {
    var rail = document.querySelector('[data-scroll-rail]')
    if (!rail) return
    var queued = false
    function paint() {
      queued = false
      var doc = document.documentElement
      var max = doc.scrollHeight - window.innerHeight
      var ratio = max > 8 ? window.scrollY / max : 0
      rail.style.setProperty('--progress', Math.min(1, Math.max(0, ratio)))
    }
    function onScroll() {
      if (queued) return
      queued = true
      requestAnimationFrame(paint)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
    paint()
  })()
</script>
