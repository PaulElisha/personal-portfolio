---
/**
 * Project card — structure and animation modelled on teddyoweh.net:
 * a 4:3 plate holding a floating browser window that rises on hover,
 * with a cursor glyph that nudges toward the name.
 */
import type { Project } from '../data'

interface Props {
  item: Project
  category: string
  delay?: number
}
const { item, category, delay = 0 } = Astro.props
const caption = item.blurb || item.summary
---

<a
  href={`/work/${item.id}?category=${category}`}
  class="card rise"
  style={`animation-delay:${delay}ms`}
  data-card
>
  <div class="card-shot">
    <div class="win">
      <span class="win-dots" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <img
        class="card-img"
        src={item.image || item.logo}
        alt={item.name}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <div class="card-cap">
    <div class="card-top">
      <span class="card-name">{item.name}</span>
      <span class="card-links" aria-hidden="true">
        <span class="route">
          <svg
            class="cursor-ico"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="none"
          >
            <path d="M5 3l14 8-6 1.6L9.6 19 5 3z"></path>
          </svg>
        </span>
      </span>
    </div>
    {item.role && <span class="card-role">{item.role}</span>}
    <p class="card-desc">{caption}</p>
  </div>
</a>
