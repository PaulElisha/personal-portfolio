---
/**
 * Floating pill navigation — the shared chrome on every route.
 * Alpine tracks scroll direction to gently fade the bar while reading.
 */
interface Props {
  pathname: string
}
const { pathname } = Astro.props

const items = [
  { to: '/', label: 'home' },
  { to: '/work', label: 'work' },
  { to: '/research', label: 'research' },
]
const isActive = (to: string) =>
  to === '/' ? pathname === '/' : pathname === to || pathname.startsWith(`${to}/`)
---

<nav
  class="fixed bottom-5 left-1/2 z-50 -translate-x-1/2"
  x-data="{ hidden: false, last: 0 }"
  x-on:scroll.window.throttle.150ms="
    const y = window.scrollY;
    hidden = y > last && y > 120;
    last = y;
  "
  :class="hidden ? 'opacity-40' : 'opacity-100'"
  style="transition: opacity .35s cubic-bezier(.22,1,.36,1)"
  aria-label="Primary"
>
  <div
    class="flex items-center gap-0.5 rounded-full border border-border bg-background/85 p-1 backdrop-blur-md"
  >
    {
      items.map(({ to, label }) => (
        <a
          href={to}
          aria-current={isActive(to) ? 'page' : undefined}
          class={`press rounded-full px-2.5 py-1 text-[12px] ${
            isActive(to)
              ? 'bg-accent text-foreground'
              : 'text-muted-foreground hover:text-foreground'
          }`}
        >
          {label}
        </a>
      ))
    }
  </div>
</nav>
